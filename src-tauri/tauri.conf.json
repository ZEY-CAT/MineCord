{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MINECORD",
  "version": "../package.json",
  "identifier": "com.minecord.app",
  "build": {
    "devUrl": "https://minecord-8vg2.onrender.com",
    "frontendDist": "splash",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["main-capability"]
    },
    "windows": [
      {
        "label": "main",
        "title": "MINECORD",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "url": "https://minecord-8vg2.onrender.com"
      }
