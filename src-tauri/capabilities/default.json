{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Scope hosted MINECORD desktop APIs to the official hosted origin.",
  "windows": ["main", "companion"],
  "remote": {
    "urls": ["https://minecord-8vg2.onrender.com"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "deep-link:default",
    "notification:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://minecord-8vg2.onrender.com/**" }
      ]
    }
  ]
}
