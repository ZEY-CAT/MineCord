PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=./server/minecord.sqlite
# Configure the existing account's immutable ID from /api/auth/me; never use a username here.
APP_OWNER_USER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback
# Optional Microsoft sign-in and Minecraft Java account linking; secrets stay server-side.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# Optional comma-separated extra origins allowed to start OAuth (for example http://192.168.1.5:3000).
OAUTH_ALLOWED_ORIGINS=
STUN_URL=
# Maximum people in one voice/video call (2-25, default 10).
MAX_CALL_PARTICIPANTS=10
# How long an unanswered call rings before timing out (1000-120000 ms, default 45000).
CALL_RING_TIMEOUT_MS=45000
# Optional self-hosted coturn fallback; Metered TURN takes precedence when configured.
TURN_URL=
TURN_SHARED_SECRET=
METERED_APP_NAME=minecord
METERED_SECRET_KEY=
# The Electron client uses desktop/config.json for its packaged server URL.
# For local development, MINECORD_SERVER_URL may override the URL.
MINECORD_SERVER_URL=http://localhost:3000
