{
  "name": "minecraft-friends",
  "version": "1.0.2",
  "private": true,
  "description": "Minecraft-themed private friends chat with accounts, servers, channels, DMs and WebRTC voice.",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron desktop/main.js",
    "build:updater": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\build-updater.ps1",
    "build:desktop": "npm run build:updater && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\generate-windows-icon.ps1 && electron-builder",
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "electron": "electron .",
    "electron:serve": "concurrently -k \"node server/server.js\" \"electron .\"",
    "test": "node --test",
    "build": "node scripts/build-web.js",
    "tauri": "tauri",
    "tauri:prepare": "npm run build",
    "tauri:dev": "npm run tauri:prepare && tauri dev",
    "tauri:build": "npm run tauri:prepare && node scripts/build-tauri.js",
    "bridge:start": "start-bridge.bat",
    "bridge:stop": "stop-bridge.bat"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "koffi": "^3.3.3",
    "pngjs": "^7.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "concurrently": "^9.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "com.minecord.app",
    "productName": "MINECORD",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "public/**",
      "package.json",
      "!desktop/**/*.map",
      "!**/.env",
      "!**/.env.*",
      "!server/**",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension"
      },
      {
        "from": "resources/MineCordUpdater.dll",
        "to": "MineCordUpdater.dll"
      }
    ],
    "win": {
      "icon": "assets/minecord.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "assets/minecord.ico",
      "uninstallerIcon": "assets/minecord.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "maintainer": "ZEY-CAT",
      "description": "Minecraft-themed private friends chat with accounts, servers, channels, DMs and WebRTC voice."
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ZEY-CAT",
        "repo": "MineCord",
        "releaseType": "draft"
      }
    ]
  }
}
