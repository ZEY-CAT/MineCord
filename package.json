{
  "name": "minecraft-friends",
  "version": "1.0.1",
  "private": true,
  "description": "Minecraft-themed private friends chat with accounts, servers, channels, DMs and WebRTC voice.",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron desktop/main.js",
    "build:desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\generate-windows-icon.ps1 && electron-builder",
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "electron": "electron .",
    "electron:serve": "concurrently -k \"node server/server.js\" \"electron .\"",
    "test": "node --test",
    "build": "node scripts/build-web.js",
    "tauri": "tauri",
    "tauri:prepare": "npm run build",
    "tauri:dev": "npm run tauri:prepare && tauri dev",
    "tauri:build": "npm run tauri:prepare && node scripts/build-tauri.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "@tauri-apps/cli": "^2.8.4"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "com.minecord.app",
    "productName": "MINECORD",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "public/**",
      "package.json",
      "!desktop/**/*.map",
      "!**/.env",
      "!**/.env.*",
      "!server/**",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension"
      }
    ],
    "win": {
      "icon": "assets/minecord.ico",
      "target": "nsis"
    },
    "nsis": {
      "installerIcon": "assets/minecord.ico",
      "uninstallerIcon": "assets/minecord.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ZEY-CAT",
        "repo": "MineCord",
        "releaseType": "draft"
      }
    ]
  }
}
